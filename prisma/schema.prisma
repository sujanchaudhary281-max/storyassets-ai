generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String    @default("member")
  passwordHash  String?
  oauthProvider String?
  oauthId       String?
  creditBalance Int       @default(3)
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  projects     Project[]
  subscription Subscription?
  generationJobs GenerationJob[]
  creditPacks    CreditPack[]
  webhookEvents  WebhookEvent[]
  activityLogs   ActivityLog[]
  projectDrafts  ProjectDraft[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Project {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String   @db.Text
  iconUrl          String?
  ageGroup         String?  @default("all-ages")
  status           String   @default("active")
  category         String
  platforms        String[]
  stylePreset      String   @default("minimal")
  brandColor       String?
  templateId       String?
  iosTemplateId    String?
  androidTemplateId String?
  matchStyleAcross Boolean  @default(true)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJobs     GenerationJob[]
  uploadedScreenshots UploadedScreenshot[]
  locales            ProjectLocale[]
  referenceImages    ReferenceImage[]
  template           Template?           @relation("ProjectTemplate", fields: [templateId], references: [id])
  iosTemplate        Template?           @relation("ProjectIosTemplate", fields: [iosTemplateId], references: [id])
  androidTemplate    Template?           @relation("ProjectAndroidTemplate", fields: [androidTemplateId], references: [id])
  activityLogs       ActivityLog[]

  @@map("projects")
}

model GenerationJob {
  id             String    @id @default(cuid())
  projectId      String
  userId         String
  status         String    @default("pending")
  creditsUsed    Int       @default(1)
  errorMessage   String?   @db.Text
  assetsZipUrl   String?
  expiresAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id])
  generatedAssets GeneratedAsset[]

  @@map("generation_jobs")
}

model GeneratedAsset {
  id              String   @id @default(cuid())
  jobId           String
  assetType       String
  platform        String?
  index           Int?
  captionHeadline String?
  captionSubtext  String?
  storageKey      String
  width           Int
  height          Int
  fileSizeBytes   Int?
  sortOrder       Int      @default(0)
  deviceSize      String?
  parentAssetId   String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  job           GenerationJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parentAsset   GeneratedAsset?    @relation("AssetDerivations", fields: [parentAssetId], references: [id])
  derivedAssets GeneratedAsset[]   @relation("AssetDerivations")
  versions      ScreenshotVersion[]
  localizedAssets LocalizedAsset[]

  @@map("generated_assets")
}

model ScreenshotVersion {
  id              String   @id @default(cuid())
  assetId         String
  captionHeadline String?
  captionSubtext  String?
  storageKey      String
  width           Int
  height          Int
  fileSizeBytes   Int?
  versionNote     String?
  createdAt       DateTime @default(now())

  asset GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("screenshot_versions")
}

model UploadedScreenshot {
  id               String   @id @default(cuid())
  projectId        String
  storageKey       String
  originalFilename String
  width            Int
  height           Int
  fileSizeBytes    Int
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("uploaded_screenshots")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("free")
  status               String    @default("active")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  monthlyGenerations   Int       @default(3)
  generationsUsed      Int       @default(0)
  maxProjects          Int       @default(1)
  maxLanguages         Int       @default(1)
  features             String[]  @default([])
  periodResetAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}


model Template {
  id          String @id @default(cuid())
  name        String
  category    String
  config      String @db.Text
  previewUrl  String?
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())

  projects        Project[] @relation("ProjectTemplate")
  iosProjects     Project[] @relation("ProjectIosTemplate")
  androidProjects Project[] @relation("ProjectAndroidTemplate")

  @@map("templates")
}

model ProjectLocale {
  id              String @id @default(cuid())
  projectId       String
  locale          String
  translationMode String @default("ai")
  status          String @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  localizedAssets LocalizedAsset[]

  @@unique([projectId, locale])
  @@map("project_locales")
}

model LocalizedAsset {
  id              String  @id @default(cuid())
  localeId        String
  assetId         String
  captionHeadline String?
  captionSubtext  String?
  storageKey      String?
  status          String  @default("pending")
  overflowDetected Boolean @default(false)
  suggestedFontSize Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  locale ProjectLocale  @relation(fields: [localeId], references: [id], onDelete: Cascade)
  asset  GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([localeId, assetId])
  @@map("localized_assets")
}

model ReferenceImage {
  id               String   @id @default(cuid())
  projectId        String
  storageKey       String
  originalFilename String
  rightsConfirmed  Boolean  @default(false)
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("reference_images")
}

model CreditPack {
  id              String   @id @default(cuid())
  userId          String
  credits         Int
  price           Int
  stripePaymentId String?  @unique
  purchasedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_packs")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  userId      String
  event       String
  payload     String    @db.Text
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhook_events")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

model ProjectDraft {
  id        String   @id @default(cuid())
  userId    String
  formData  Json
  step      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("project_drafts")
}
